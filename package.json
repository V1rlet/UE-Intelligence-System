{
	"name": "graph-brain",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "本地优先的只读 UE 代码架构查看器，支持代码事实提取、查询与标注",
	"scripts": {
		"viewer": "vite",
		"serve": "tsx scripts/service-launcher.ts",
		"build": "vite build",
		"check:bundle": "node tools/bundle-boundary-check.mjs",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test tests/*.test.ts",
		"smoke:visual": "tsx tests/visual-smoke.ts",
		"smoke:interactive": "tsx tests/interactive-smoke.ts",
		"smoke:motion": "tsx tests/motion-smoke.ts",
		"smoke:soak": "tsx tests/runtime-soak-smoke.ts",
		"smoke": "tsx tests/smoke-runner.ts",
		"smoke:update-golden": "tsx tools/update-smoke-golden.ts",
		"service:prepare": "tsx tools/service-deploy.ts prepare",
		"service:activate": "tsx tools/service-deploy.ts activate",
		"service:rollback": "tsx tools/service-deploy.ts rollback",
		"service:status": "tsx tools/service-deploy.ts status",
		"check:fast": "npm run engineering-standard-gate && npm run layer-gate && npm run typecheck && npm test && npm run validate",
		"check:data": "tsx --test tests/evidence-contract.test.ts tests/evidence-query.test.ts tests/evidence-refresh.test.ts tests/evidence-snapshot-v3.test.ts tests/evidence-status.test.ts tests/curated-reference-archive.test.ts tests/authoring-retirement.test.ts tests/reading-context-input.test.ts && npm run evidence:check",
		"check:release": "npm run check:fast && npm run check:data && npm run build && npm run check:bundle && npm run smoke",
		"check:lifecycle": "npm run smoke:soak",
		"check": "npm run check:release",
		"gate:arch": "tsx scripts/gate-arch.ts",
		"validate": "tsx core/schema/validate.ts",
		"engineering-standard-gate": "tsx scripts/engineering-standard-gate.ts",
		"layer-gate": "tsx scripts/layer-gate.ts",
		"extract:ue5-classes": "tsx adapters/ue5-code/extract-classes.ts",
		"sync:ue-api": "tsx adapters/ue5-code/epic-api-sync.ts",
		"analyze": "tsx core/query/analyze.ts",
		"archify:bridge": "tsx tools/archify-bridge.ts",
		"annotations:scan": "tsx core/annotation/scan-stale.ts",
		"hook:update": "tsx core/hooks/post-commit-update.ts",
		"hook:install": "tsx core/hooks/install-git-hook.ts",
		"mcp": "tsx tools/mcp-server.ts",
		"evidence": "tsx tools/evidence.ts",
		"evidence:status": "tsx tools/evidence.ts status",
		"evidence:check": "tsx tools/evidence.ts check",
		"evidence:refresh": "tsx tools/evidence.ts refresh",
		"evidence:snapshot": "tsx tools/evidence-snapshot.ts",
		"export:context": "tsx tools/export-context.ts",
		"archive:curated-references": "tsx tools/archive-curated-references.ts",
		"audit:colors": "node tools/css-color-audit.mjs",
		"cache:aging": "tsx tools/engine-cache-aging.ts",
		"data:tidy": "tsx core/store/tidy-graphs.ts",
		"data:status": "tsx tools/data-publication.ts status",
		"data:rollback": "tsx tools/data-publication.ts rollback",
		"data:prune": "tsx tools/data-publication.ts prune",
		"migrate:graph-versions": "tsx tools/migrate-graph-format-version.ts",
		"migrate:reading-context": "tsx tools/migrate-reading-context.ts",
		"build:change-report": "tsx tools/build-change-report.ts",
		"annotations:backfill": "tsx tools/backfill-annotation-hash.ts"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"cytoscape": "^3.34.0",
		"cytoscape-fcose": "^2.2.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/cytoscape": "^3.21.9",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"esbuild": "^0.28.1",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0",
		"vite": "^8.1.3"
	}
}