{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://graph-brain.local/schema/reading-context.schema.json",
  "title": "GraphBrain Reading Context",
  "description": "Versioned user-owned reading state for ue5_code facts: annotations and favorites.",
  "type": "object",
  "required": ["format_version", "domain", "revision", "updated_at", "annotations", "favorites"],
  "properties": {
    "format_version": { "const": 2 },
    "domain": { "const": "ue5_code" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subsystem", "node_id", "annotations"],
        "properties": {
          "subsystem": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string", "minLength": 1 },
          "annotations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "content", "created_at"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["gotcha", "best_practice", "design_decision", "performance", "reference"] },
                "content": { "type": "string", "minLength": 1 },
                "created_at": { "type": "string", "format": "date-time" },
                "updated_at": { "type": "string", "format": "date-time" },
                "source_hash": { "type": "string" },
                "stale": { "type": "boolean" },
                "anchor": {
                  "type": "object",
                  "description": "D-P3 行级锚：标注绑定的源文件行区间；fingerprint 为该区间原始字节的 sha256。失效半径=该行区间。",
                  "required": ["start_line", "end_line", "fingerprint"],
                  "properties": {
                    "start_line": { "type": "integer", "minimum": 1 },
                    "end_line": { "type": "integer", "minimum": 1 },
                    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source", "node_id", "added_at"],
        "properties": {
          "kind": { "enum": ["class", "function"] },
          "source": { "enum": ["project", "engine", "unknown"] },
          "node_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "parent_id": { "type": "string" },
          "module": { "type": "string" },
          "source_path": { "type": "string" },
          "added_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
