{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://graph-brain.local/schema/node.schema.json",
  "title": "Graph Brain Node",
  "description": "GraphBrain 的 ue5_code 节点（Cytoscape.js 兼容）。",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "label", "type", "domain"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "module", "uclass", "uactor", "ucomponent", "ustruct",
            "uenum", "uinterface", "ufunction", "blueprint",
            "lifecycle_step", "meta_group", "folder", "file",
            "execution_lane", "scheduler", "system"
          ]
        },
        "layer": { "enum": ["engine", "plugin", "project"] },
        "module": { "type": "string" },
        "domain": { "const": "ue5_code" },
        "parent": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source_path": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "visibility": { "enum": ["fog", "silhouette", "explored"] },
        "children_count": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "properties": {
            "in_degree": { "type": "integer", "minimum": 0 },
            "out_degree": { "type": "integer", "minimum": 0 },
            "betweenness": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "api": { "$ref": "#/definitions/api" },
		"cpp_declarations": {
		  "type": "array",
		  "items": {
			"type": "object",
			"required": ["name", "kind", "bases", "description"],
			"properties": {
			  "name": { "type": "string", "minLength": 1 },
			  "kind": { "enum": ["class", "struct", "enum"] },
			  "bases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
			  "description": { "type": "string" },
			  "reflection": { "enum": ["USTRUCT", "UENUM"] }
			},
			"additionalProperties": false
		  }
		}
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "ufunction" } },
            "required": ["type"]
          },
          "then": { "required": ["api", "parent"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "meta_group" } },
            "required": ["type"]
          },
          "then": { "required": ["children_count"] }
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "classes": { "type": "string" }
  },
  "additionalProperties": false,
  "definitions": {
    "api": {
      "type": "object",
      "description": "ufunction 节点的 API 扩展字段，驱动 API Reference View",
      "required": ["signature", "return_type"],
      "properties": {
        "signature": { "type": "string", "minLength": 1 },
        "return_type": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "companions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cpp_only": { "type": "boolean" },
        "blueprint_exposable": { "type": "boolean" },
        "is_static": { "type": "boolean" },
        "trigger": { "type": "string", "minLength": 1 },
        "behavior": { "type": "string", "minLength": 1 },
        "edge_cases": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
