{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://graph-brain.local/schema/annotation.schema.json",
  "title": "Graph Brain Annotation File (*_annotations.json)",
  "description": "Legacy/API annotation projection. Active persistence is reading-context.schema.json; this array shape remains only for examples and thin endpoint compatibility.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["node_id", "domain", "annotations"],
    "properties": {
      "node_id": { "type": "string", "minLength": 1 },
        "domain": { "const": "ue5_code" },
      "annotations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "type", "content", "created_at"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": {
              "enum": ["gotcha", "best_practice", "design_decision", "performance", "reference"]
            },
            "content": { "type": "string", "minLength": 1 },
            "created_at": { "type": "string", "format": "date-time" },
            "source_hash": { "type": "string" },
            "stale": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
