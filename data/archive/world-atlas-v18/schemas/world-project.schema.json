{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://graph-brain.local/schema/world-project.schema.json",
  "title": "Graph Brain World Project Manifest",
  "type": "object",
  "required": ["project_id", "label", "description", "atlas", "quest_program", "default_scenario", "sources"],
  "properties": {
    "format_version": { "const": 2 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "atlas": { "type": "string", "pattern": "^[^/\\\\]+\\.json$" },
    "quest_program": { "type": "string", "pattern": "^[^/\\\\]+\\.json$" },
    "default_scenario": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["domain", "subsystem", "revision_policy"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "subsystem": { "type": "string", "minLength": 1 },
          "revision_policy": { "enum": ["latest", "latest_final"] }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "domain", "subsystem", "revision_policy"],
        "properties": {
          "kind": { "const": "graph" },
          "domain": { "type": "string", "minLength": 1 },
          "subsystem": { "type": "string", "minLength": 1 },
          "revision_policy": { "enum": ["latest", "latest_final"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
