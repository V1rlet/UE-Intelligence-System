  "updated_at": "2026-08-09T18:59:22.610Z",
  "annotations": [
    {
      "subsystem": "framework-reference",
      "node_id": "ACharacter",
      "annotations": [
        {
          "id": "ann_ref_008",
          "type": "gotcha",
          "content": "CharacterMovementComponent 自带客户端预测与服务器校正。自定义移动（冲刺、滑铲）优先扩展 CMC（自定义 MovementMode / RootMotionSource），自写 SetActorLocation 位移会破坏网络预测。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "93c2fb0f2be9a9412a0991356323d2d37f8333b5"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "AGameModeBase",
      "annotations": [
        {
          "id": "ann_ref_001",
          "type": "gotcha",
          "content": "客户端上不存在 GameMode——客户端代码里 GetGameMode() 拿到的是 nullptr（单机/监听服务器本机除外）。客户端要查规则状态，走 GameState。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "1762ee0d645d8a5284610f291dabe456b2cd55a0"
        },
        {
          "id": "ann_ref_002",
          "type": "best_practice",
          "content": "规则、胜负判定、玩家生成逻辑放这里；但会话级数据（玩家档案、跨局统计）不要放——切图时 GameMode 会销毁重建，跨关卡数据的归宿是 GameInstance / GameInstanceSubsystem。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "1762ee0d645d8a5284610f291dabe456b2cd55a0"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "AGameStateBase",
      "annotations": [
        {
          "id": "ann_ref_003",
          "type": "best_practice",
          "content": "想让所有端都看到的比赛数据（剩余时间、比分、阶段）放这里并标记 Replicated；GameMode 算出来的结果通过 GameState 广播，这是引擎规定的\"服务器算、全端看\"分工。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "e1741be7821c8227859314bae26f287019d21495"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "APawn",
      "annotations": [
        {
          "id": "ann_ref_007",
          "type": "best_practice",
          "content": "Pawn 是\"身体\"：设计上允许被销毁、重生、换乘（载具）。任何需要跨越死亡存续的数据都不属于 Pawn——放 PlayerState（公开）或 PC（私有）。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "44c41246e3da6a668c0baa3810cb076817cc1cd9"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "APlayerController",
      "annotations": [
        {
          "id": "ann_ref_004",
          "type": "best_practice",
          "content": "职责分界：输入路由与 UI 归 PlayerController，gameplay 能力归 Pawn。Pawn 会死亡重生，PC 全程常驻——放错位置的逻辑会在重生时丢失或悬空。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "55634503a45d8620107ec89373956d4d2ecf8cbe"
        },
        {
          "id": "ann_ref_005",
          "type": "gotcha",
          "content": "PC 的 BeginPlay 时未必已经 Possess 到 Pawn（多人时序不保证）。依赖 Pawn 的初始化写在 OnPossess / OnRep_Pawn，不要写在 BeginPlay。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "55634503a45d8620107ec89373956d4d2ecf8cbe"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "APlayerState",
      "annotations": [
        {
          "id": "ann_ref_006",
          "type": "best_practice",
          "content": "玩家的公开状态（名字、分数、队伍）放 PlayerState：它复制到所有端。PlayerController 只存在于服务器和拥有端，放在 PC 上的数据别的玩家永远看不到。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "5a648594ecc8a03597c5912acbaa371e2a5b3064"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "lifecycle:PostLogin",
      "annotations": [
        {
          "id": "ann_ref_012",
          "type": "best_practice",
          "content": "多人加入流程的服务器挂点：PostLogin 时 PlayerController 已就绪、PlayerState 已入 PlayerArray，适合在这里做队伍分配与初始化 RPC。更早的 PreLogin 只适合做准入校验。",
          "created_at": "2026-07-11T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "UGameInstance",
      "annotations": [
        {
          "id": "ann_ref_009",
          "type": "gotcha",
          "content": "不要在 GameInstance 里缓存 World 内对象（Actor/Component）的强引用——切图后 World 销毁，引用悬空。需要跨图传递的用数据（struct/id），进新图后重新解析。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "19a6de71ee2cac9e7d3d99493d7fc99cb6a5a706"
        },
        {
          "id": "ann_ref_010",
          "type": "best_practice",
          "content": "跨关卡存续的服务（存档、账号、匹配）用 UGameInstanceSubsystem，不要手写单例：Subsystem 由引擎管理生命周期、自动实例化、蓝图可直取。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "19a6de71ee2cac9e7d3d99493d7fc99cb6a5a706"
        }
      ]
    },
    {
      "subsystem": "framework-reference",
      "node_id": "UUserWidget",
      "annotations": [
        {
          "id": "ann_ref_011",
          "type": "best_practice",
          "content": "CreateWidget 的 Owner 传 PlayerController；UI 逻辑不进 GameMode（服务器上没有 UI，专用服务器构建里这类代码是死代码或崩溃点）。",
          "created_at": "2026-07-11T00:00:00.000Z",
          "source_hash": "8ff1d3504ff9ef9df92512a77beecf4cdf5e5f0a"
        }
      ]
    },
    {
      "subsystem": "gameplay-framework-reference",
      "node_id": "AGameModeBase",
      "annotations": [
        {
          "id": "ann_gf_gamemode",
          "type": "gotcha",
          "content": "GameMode 只存在于服务器；客户端规则展示必须读取 GameState。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "gameplay-framework-reference",
      "node_id": "APawn",
      "annotations": [
        {
          "id": "ann_gf_pawn",
          "type": "gotcha",
          "content": "Pawn 是可替换身体；跨重生数据应进入 PlayerState 或其他更长生命周期作用域。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "gameplay-framework-reference",
      "node_id": "APlayerController",
      "annotations": [
        {
          "id": "ann_gf_pc",
          "type": "best_practice",
          "content": "PlayerController 只存在于服务器和拥有端；不要把所有玩家都要看到的数据放在这里。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "lyra-architecture-reference",
      "node_id": "ALyraPlayerState",
      "annotations": [
        {
          "id": "ann_lyra_ps",
          "type": "best_practice",
          "content": "玩家 ASC 由 PlayerState 持有，OwnerActor=PlayerState，AvatarActor=当前 Pawn，因此可跨 Pawn 重生保留能力状态。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "lyra-architecture-reference",
      "node_id": "ULyraExperienceManagerComponent",
      "annotations": [
        {
          "id": "ann_lyra_exp",
          "type": "best_practice",
          "content": "Experience 加载是异步装配过程；依赖插件、PawnData 或输入的系统应等待 ExperienceLoaded。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    },
    {
      "subsystem": "lyra-architecture-reference",
      "node_id": "ULyraPawnExtensionComponent",
      "annotations": [
        {
          "id": "ann_lyra_extension",
          "type": "gotcha",
          "content": "不要用 BeginPlay + Delay 猜依赖就绪；Lyra 使用 InitState 协调 PawnData、Controller、PlayerState 与 ASC。",
          "created_at": "2026-07-12T00:00:00.000Z"
        }
      ]
    }
  ],
