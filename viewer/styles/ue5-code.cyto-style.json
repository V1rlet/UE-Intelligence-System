[
	{
		"selector": "node",
		"style": {
			"label": "data(label)",
			"width": "data(size)",
			"height": "data(size)",
			"font-size": 11,
			"text-valign": "bottom",
			"text-margin-y": 6,
			"color": "#c9d4de",
			"background-color": "#7f8c8d",
			"border-width": 2,
			"border-color": "#1f2d3a"
		}
	},
	{ "selector": "node[layer = 'project']", "style": { "background-color": "#e8834a" } },
	{ "selector": "node[layer = 'engine']", "style": { "background-color": "#4a90d9" } },
	{ "selector": "node[layer = 'plugin']", "style": { "background-color": "#8e63c5" } },
	{
		"selector": "node[visibility = 'silhouette']",
		"style": { "border-style": "dashed", "background-opacity": 0.75 }
	},
	{
		"selector": "node[visibility = 'fog']",
		"style": { "border-style": "dotted", "background-opacity": 0.35 }
	},
	{
		"selector": "node:selected",
		"style": { "border-color": "#f1c40f", "border-width": 4 }
	},
	{
		"selector": "edge",
		"style": {
			"curve-style": "bezier",
			"width": 2,
			"line-color": "#5d6d7c",
			"target-arrow-shape": "triangle",
			"target-arrow-color": "#5d6d7c",
			"arrow-scale": 1.1
		}
	},
	{
		"selector": "edge[weight]",
		"style": { "width": "mapData(weight, 1, 5, 1.5, 5)" }
	}
]
