{
  "compilerOptions": {
    "target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
	"include": ["core/**/*.ts", "adapters/**/*.ts", "viewer/**/*.ts", "viewer/**/*.tsx", "tests/**/*.ts", "vite.config.ts"]
}
